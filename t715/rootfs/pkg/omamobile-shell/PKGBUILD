)

# What this build keeps of upstream's install script's output.
_plugins=(omamobile.bar omamobile.quicksettings omamobile.call omamobile.launcher
          omamobile.switcher omamobile.home omamobile.keyboard omamobile.back)
_bins=(omamobile-setup-user omamobile-launch omamobile-home omamobile-osk-watch
       omamobile-bt-agent omamobile-screenrecord omamobile-widget
       omamobile-call-watch omamobile-cell-watch
       omamobile-keyboard-languages omamobile-set-pin
       omamobile-screenshot-open omamobile-screenshot-edit)

prepare() {
  bsdtar -xf "$srcdir/$_tarball" "$_dir"
  cd "$srcdir/$_dir"
  [[ $(cat version) == "$pkgver" ]] || { echo "upstream version is not $pkgver" >&2; return 1; }
  local p
  for p in "${_patches[@]}"; do
    patch -Np1 --fuzz=0 -i "$srcdir/$p"
  done
  cp "$srcdir/tablet-shell.json" profile/shell.json
  cp "$srcdir/tablet-home.json" profile/home.json
}

check() {
  cd "$srcdir/$_dir"
  local f p
  # Every shipped bin parses under its own interpreter.
  for f in "${_bins[@]}"; do
    case "$(head -n1 "bin/$f")" in
      *python3*) python3 -I -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' "bin/$f" ;;
      *bash*|*sh*) bash -n "bin/$f" ;;
      *)         echo "bin/$f: unknown interpreter" >&2; return 1 ;;
    esac
  done
  for f in plugins/omamobile.quicksettings/tile-state.sh plugins/omamobile.quicksettings/tile-action.sh \
           plugins/omamobile.home/locate.sh; do
    bash -n "$f"
  done
  # The plugins this build ships have valid manifests with the ids we expect.
  for p in "${_plugins[@]}"; do
    python3 -c 'import json, sys; m = json.load(open(sys.argv[1])); assert m["id"] == sys.argv[2], m["id"]' \
      "plugins/$p/manifest.json" "$p"
  done
  # The tablet profile: only shipped plugins named, the drawer at 6 columns,
  # both modem watchers on, idle timers off, and disabledPlugins only
  # Omarchy's bar-widget-only plugins and omarchy.remote-session: never
  # omarchy.menu, omarchy.media or a service the tablet uses (omarchy.idle).
  python3 - profile/shell.json "${_plugins[@]}" <<'PY'
import json, sys
config = json.load(open(sys.argv[1]))
shipped = set(sys.argv[2:])
named = {config["bar"]["id"], config["bar"]["quickSettings"]} | {p["id"] for p in config["plugins"]}
assert named <= shipped, sorted(named - shipped)
assert [p.get("columns") for p in config["plugins"] if p["id"] == "omamobile.launcher"] == [6]
assert config["bar"].get("cellWatch", False) and config["bar"].get("callWatch", False)
assert config["idle"] == {"screensaver": 0, "lock": 0}, config["idle"]
disabled = config["disabledPlugins"]
assert isinstance(disabled, list) and len(set(disabled)) == len(disabled), disabled
kept = {"omarchy." + k for k in "menu media background lock notifications polkit idle battery "
        "nightlight clipboard image-picker osd".split()}
assert not set(disabled) & kept, sorted(set(disabled) & kept)
widgets = {"omarchy." + w for w in "agents active-window indicators keyboard-layout microphone spacer "
           "system-update tray workspaces audio bluetooth clock dropbox monitor network power "
           "tailscale weather remote-session".split()}
assert set(disabled) <= widgets, sorted(set(disabled) - widgets)
PY
  python3 -c 'import json, sys; h = json.load(open(sys.argv[1])); assert h["grid"] == {"columns": 6, "rows": 8}' profile/home.json
  # The home layout survives HomeModel.normalize unchanged in its grid and items.
  node - <<'JS'
const H = require("./plugins/omamobile.home/HomeModel.js")
const fs = require("fs")
const raw = JSON.parse(fs.readFileSync("profile/home.json", "utf8"))
const layout = H.normalize(raw, H.REGISTRY)
if (!layout) throw new Error("profile/home.json is not a layout")
if (layout.grid.columns !== 6 || layout.grid.rows !== 8) throw new Error("grid clamped: " + JSON.stringify(layout.grid))
const items = (p) => p.items.map((i) => i.id).join(",")
if (layout.pages.map(items).join("|") !== raw.pages.map(items).join("|")) throw new Error("items moved")
JS
  # The SM-T715's own patches are in (0005-0013).
  grep -q '{ id: "rotate", label: "Rotate" }' plugins/omamobile.quicksettings/TilesModel.js
  grep -q '"t715-rotate", "turn"' plugins/omamobile.quicksettings/QuickSettings.qml
  grep -q 'tileRefresh(rotationLock, "rotation-lock")' plugins/omamobile.quicksettings/QuickSettings.qml
  grep -q '{ id: "sdcard", label: "SD card" }' plugins/omamobile.quicksettings/TilesModel.js
  grep -q 'exec t715-sdcard mount; else exec t715-sdcard eject' plugins/omamobile.quicksettings/tile-action.sh
  grep -q '"sdcard": sdcard' plugins/omamobile.quicksettings/QuickSettings.qml
  grep -q 'have t715-sdcard' plugins/omamobile.quicksettings/tile-state.sh
  grep -q 'nmcli radio wwan off' plugins/omamobile.quicksettings/tile-action.sh
  grep -q 'signal=SIGHUP t715-keys.service' plugins/omamobile.back/BackModel.js
  grep -q 'Quickshell.execDetached(BackModel.BACK_ARGV)' plugins/omamobile.back/Back.qml
  grep -q 't715-sudo-asks-password' bin/omamobile-set-pin
  grep -q 'touch ~/.local/state/omarchy/toggles/suspend-off' bin/omamobile-setup-user
  # The Mobile data tile over NetworkManager and shannond (0010), its long
  # press opening Réseau mobile (0011), and the Modem tile over
  # t715-modem-power (0012).
  grep -q '{ id: "mobile-data", label: "Mobile data" }' plugins/omamobile.quicksettings/TilesModel.js
  grep -q '{ id: "modem", label: "Modem" }' plugins/omamobile.quicksettings/TilesModel.js
  grep -q 'modemStatus: modemStatus' plugins/omamobile.quicksettings/TilesModel.js
  grep -q 'LC_ALL=C nmcli -t -f NAME,TYPE connection show' plugins/omamobile.quicksettings/tile-action.sh
  grep -q 'connection up "$con"' plugins/omamobile.quicksettings/tile-action.sh
  grep -q 'exec t715-modem-power "$want"' plugins/omamobile.quicksettings/tile-action.sh
  grep -q 'LC_ALL=C t nmcli -t -f TYPE device' plugins/omamobile.quicksettings/tile-state.sh
  grep -q 't shannonctl status' plugins/omamobile.quicksettings/tile-state.sh
  grep -q 'have t715-modem-power' plugins/omamobile.quicksettings/tile-state.sh
  grep -q '"modem": modem' plugins/omamobile.quicksettings/QuickSettings.qml
  grep -q 'id: modem' plugins/omamobile.quicksettings/QuickSettings.qml
  grep -q 'Modem off' plugins/omamobile.quicksettings/QuickSettings.qml
  grep -q 'Quickshell.execDetached(\["t715-mobile-settings"\])' plugins/omamobile.quicksettings/QuickSettings.qml
  # The call card's Speaker toggle is hidden (0013): no earpiece.
  sed -n '/objectName: "speakerToggle"/,+2p' plugins/omamobile.call/CallCard.qml | grep -q 'visible: false'
  if grep -nE '"(torch|nfc|fingerprint|location)"' plugins/omamobile.quicksettings/TilesModel.js; then
    echo "TilesModel.js still lists a phone tile" >&2
    return 1
  fi
  if grep -nE '(exec|have) omamobile-sit' plugins/omamobile.quicksettings/tile-action.sh plugins/omamobile.quicksettings/tile-state.sh; then
    echo "the mobile data tile still calls omamobile-sit" >&2
    return 1
  fi
  if grep -rniE 'yt-j706f|yoga tab|mt7663' bin plugins test; then
    echo "another tablet's wording left" >&2
    return 1
  fi
  # The modem pieces are on: the call plugin and both watchers (0004, 0013,
  # tablet-shell.json).
  python3 -c 'import json, sys; c = json.load(open(sys.argv[1])); assert c["bar"]["cellWatch"] and c["bar"]["callWatch"]; assert {"id": "omamobile.call"} in c["plugins"]' profile/shell.json
  # Upstream's own suite, the parts this build ships (as Lenovomarchy runs it).
  bash test/tile-scripts.sh
  bash test/dnd-state.sh
  bash test/setup-user.sh
  for t in tiles-model wifi-model bluetooth-model gesture-model home-model \
           back-model back-link switcher-model notifications-model media-model \
           keyboard-model status-model battery-state; do
    node "test/$t.js" >/dev/null
  done
  bash test/install-hook.sh
  bash test/osk-guard.sh
  bash test/keyboard-theme.sh >/dev/null
  bash test/home-command.sh
  bash test/reboot-command.sh
  python3 -B test/launch.py
  python3 -B test/widget-tool.py
  python3 -B test/bt-agent.py
  python3 -B test/doubletap.py
}

package() {
  cd "$srcdir/$_dir"
  local f p share="$pkgdir/usr/share/omamobile/shell"
  for f in "${_bins[@]}"; do
    install -Dm755 "bin/$f" "$pkgdir/usr/bin/$f"
  done
  for p in "${_plugins[@]}"; do
    while IFS= read -r -d '' f; do
      install -Dm644 "$f" "$share/$f"
    done < <(find "plugins/$p" -type f -print0)
  done
  install -Dm644 plugins/README.md "$share/plugins/README.md"
  while IFS= read -r -d '' f; do
    install -Dm644 "$f" "$share/$f"
  done < <(find profile branding -type f -print0)
  install -Dm644 widgets/WIDGETS.md "$share/WIDGETS.md"
  install -Dm644 widgets/OWL.md "$share/OWL.md"
  while IFS= read -r -d '' f; do
    install -Dm644 "$f" "$share/widget-${f#widgets/}"
  done < <(find widgets/template widgets/examples -type f -print0)
  install -Dm644 systemd/user/omamobile-setup-user.service "$pkgdir/usr/lib/systemd/user/omamobile-setup-user.service"
  install -d "$pkgdir/usr/lib/systemd/user/graphical-session-pre.target.wants"
  ln -sfn ../omamobile-setup-user.service \
    "$pkgdir/usr/lib/systemd/user/graphical-session-pre.target.wants/omamobile-setup-user.service"
  install -Dm644 environment.d/30-omamobile-screenshot.conf \
    "$pkgdir/usr/lib/environment.d/30-omamobile-screenshot.conf"
  install -Dm644 polkit/49-omamobile-admin-self.rules "$pkgdir/usr/share/polkit-1/rules.d/49-omamobile-admin-self.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 widgets/LICENSE-owl-guide "$pkgdir/usr/share/licenses/$pkgname/LICENSE-owl-guide"
  install -Dm644 version "$share/version"
}

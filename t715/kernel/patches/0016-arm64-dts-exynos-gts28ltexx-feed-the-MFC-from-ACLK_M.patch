From 4017a57366f85b81a5b1ddb066cf92d41f3fb86e Mon Sep 17 00:00:00 2001
From: elkir0 <elkir0@users.noreply.github.com>
Date: Sat, 28 Nov 2026 12:00:00 +0000
Subject: [PATCH] arm64: dts: exynos: gts28ltexx: feed the MFC from
 ACLK_MFC_400

The SoC's MFC v8 node (exynos5433.dtsi, codec@152e0000) is complete and
enabled, but as on TM2 the board has to set CMU_MFC's input mux to
ACLK_MFC_400, or it can stay on the oscillator. A 64-bit-only fragment,
exynos5433-gts28ltexx-mfc.dtsi, does it. With CONFIG_VIDEO_SAMSUNG_S5P_MFC
(a module) and s5p-mfc-v8.fw in the root, s5p-mfc registers its decoder
and encoder.

On the SM-T715, 2026-11-28: "preallocated 8 MiB buffer for the firmware
and context buffers", the decoder and encoder nodes, and a 1080p30 H.264
clip decoded at 150 fps for 0.54 s of CPU with FFmpeg's h264_v4l2m2m,
against 135 fps for 8.00 s in software.
---
 .../boot/dts/exynos/exynos5433-gts28ltexx-mfc.dtsi | 14 ++++++++++++++
 .../boot/dts/exynos/exynos5433-gts28ltexx.dts      |  1 +
 2 files changed, 15 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx-mfc.dtsi

diff --git a/arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx-mfc.dtsi b/arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx-mfc.dtsi
new file mode 100644
index 000000000..3880b465e
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx-mfc.dtsi
@@ -0,0 +1,14 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Galaxy Tab S2 8.0 LTE (SM-T715), 64-bit only: the MFC v8 video codec.
+ *
+ * The SoC's node (exynos5433.dtsi, codec@152e0000) is complete and enabled;
+ * as on TM2 (exynos5433-tm2-common.dtsi) the board only has to feed the MFC
+ * block from ACLK_MFC_400, or its mux can stay on the oscillator.  The
+ * driver (s5p-mfc, a module) loads s5p-mfc-v8.fw at first open.
+ */
+
+&cmu_mfc {
+	assigned-clocks = <&cmu_mfc CLK_MOUT_ACLK_MFC_400_USER>;
+	assigned-clock-parents = <&cmu_top CLK_ACLK_MFC_400>;
+};
diff --git a/arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx.dts b/arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx.dts
index 207fc02e4..044051740 100644
--- a/arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx.dts
+++ b/arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx.dts
@@ -14,3 +14,4 @@
 #include "exynos5433-gts28ltexx-no-sysmmu.dtsi"
 #include "exynos5433-gts28ltexx-eas.dtsi"
 #include "exynos5433-gts28ltexx-otg.dtsi"
+#include "exynos5433-gts28ltexx-mfc.dtsi"
-- 

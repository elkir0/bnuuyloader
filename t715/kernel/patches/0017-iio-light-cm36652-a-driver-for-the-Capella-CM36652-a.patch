+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/iio/light/capella,cm36652.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Capella CM36652 I2C Proximity and Color Light sensor
+
+maintainers:
+  - elkir0 <elkir0@users.noreply.github.com>
+
+description: |
+  Color light sensor (red, green, blue and white channels) and proximity
+  sensor with its IR LED driver, at I2C address 0x60, with 16-bit SMBus word
+  registers.
+
+properties:
+  compatible:
+    const: capella,cm36652
+
+  reg:
+    maxItems: 1
+
+  vdd-supply:
+    description: Supply for the sensor.
+
+additionalProperties: false
+
+required:
+  - compatible
+  - reg
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        light-sensor@60 {
+            compatible = "capella,cm36652";
+            reg = <0x60>;
+            vdd-supply = <&ldo_sensor>;
+        };
+    };
+...
diff --git a/arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx-als.dtsi b/arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx-als.dtsi
new file mode 100644
index 000000000..d2771ddb7
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos5433-gts28ltexx-als.dtsi
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung Galaxy Tab S2 8.0 LTE (SM-T715), 64-bit kernel: the ambient light
+ * sensor.
+ *
+ * A Capella CM36652 color light and proximity sensor at 0x60 on a
+ * bit-banged I2C bus, as in the stock tree: i2c-gpio, SDA on gpd4-1, SCL on
+ * gpd4-2, 2 us delay, both pins plain GPIO with no pull, no regulator named.
+ * cm36652.ko drives the light half only, polled.  The chip's interrupt line
+ * (gpa0-5) serves the proximity half alone, which the driver keeps in
+ * shutdown, so it is not described here.
+ */
+
+/ {
+	i2c_als: i2c-als {
+		compatible = "i2c-gpio";
+		sda-gpios = <&gpd4 1 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpd4 2 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		i2c-gpio,delay-us = <2>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&als_i2c_pins>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		light-sensor@60 {
+			compatible = "capella,cm36652";
+			reg = <0x60>;
+		};
+	};
+};
+
+/*
+ * Plain GPIO with no pull, as stock sets both pins: the bus has its pull-ups
+ * on the board, which a pad pull-down would fight.
+ */
+&pinctrl_peric {
+	als_i2c_pins: als-i2c-pins {
+		samsung,pins = "gpd4-1", "gpd4-2";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5433_PIN_DRV_FAST_SR1>;
+	};
+};

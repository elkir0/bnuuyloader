 .../dts/exynos/exynos5433-gts28ltexx-als.dtsi |  43 +++
 .../boot/dts/exynos/exynos5433-gts28ltexx.dts |   1 +
 drivers/iio/light/Kconfig                     |  12 +
 drivers/iio/light/Makefile                    |   1 +
 drivers/iio/light/cm36652.c                   | 347 ++++++++++++++++++
 6 files changed, 449 insertions(+)

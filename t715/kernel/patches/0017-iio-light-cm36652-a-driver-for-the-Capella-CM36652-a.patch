diff --git a/drivers/iio/light/cm36652.c b/drivers/iio/light/cm36652.c
new file mode 100644
index 000000000..2ed50445c
--- /dev/null
+++ b/drivers/iio/light/cm36652.c
@@ -0,0 +1,347 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Capella CM36652 color light and proximity sensor
+ *
+ * IIO driver for the ambient light half (red, green, blue and white
+ * channels) of the CM36652, 7-bit I2C address 0x60, 16-bit little-endian
+ * SMBus word registers.  Polled: the interrupt line only serves the
+ * proximity half, which is kept in shutdown so that its IR LED never runs.
+ *
+ * Register map, normal configuration and shutdown values: Samsung's GPL
+ * driver for this chip (Galaxy Note 4 Exynos kernel).  That driver never
+ * changes the color integration time and has no lux conversion, so both come
+ * from the CM3323 (also sold as the Vishay VEML6040), which is this chip's
+ * color block without the proximity half (its integration time field, two
+ * bits here, was checked on the tablet): the same configuration word at
+ * 0x00 with the same shutdown bit, the same R, G, B and W data registers at
+ * 0x08-0x0b, and reserved registers at 0x01-0x07, where the CM36652 keeps
+ * its proximity ones.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/cleanup.h>
+#include <linux/i2c.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pm.h>
+#include <linux/regulator/consumer.h>
+
+#include <linux/iio/iio.h>
+
+#define CM36652_DRV_NAME	"cm36652"
+
+#define CM36652_REG_CS_CONF1	0x00
+#define CM36652_REG_PS_CONF1	0x03
+#define CM36652_REG_PS_CONF3	0x04
+#define CM36652_REG_RED		0x08
+#define CM36652_REG_GREEN	0x09
+#define CM36652_REG_BLUE	0x0a
+#define CM36652_REG_WHITE	0x0b
+
+/* CS_CONF1: color sensor configuration */
+#define CM36652_CS_SD		BIT(0)		/* shutdown */
+#define CM36652_CS_IT_MASK	GENMASK(5, 4)	/* integration time */
+
+/*
+ * Samsung's "enable" word for normal operation: color sensor on, every
+ * other bit clear (auto mode, shortest integration time).
+ */
+#define CM36652_CS_CONF1_NORMAL	0x0000
+
+/*
+ * Samsung's proximity "off" words: PS_CONF1 with only its shutdown bit set
+ * (the IR LED is driven only while the proximity sensor runs), PS_CONF3
+ * cleared.
+ */
+#define CM36652_PS_CONF1_OFF	0x0001
+#define CM36652_PS_CONF3_OFF	0x0000
+
+/*
+ * Integration times, indexed by the CS_IT field: 40 ms doubled at each
+ * step.  Unlike the CM3323's three bits, the field is two bits wide here:
+ * measured on the SM-T715 under steady light, IT 0-3 doubled the counts
+ * each time, and the CM3323's codes 4 and 5 read like 0 and 1.
+ */
+static const int cm36652_int_time[][2] = {
+	{ 0, 40000 },
+	{ 0, 80000 },
+	{ 0, 160000 },
+	{ 0, 320000 },
+};
+
+/*
+ * Illuminance from the green channel.  Approximation: 0.25168 lux per count
+ * at 40 ms, halved at each doubling of the integration time, is the green
+ * sensitivity published for the CM3323/VEML6040 bare die.  The CM36652 sits
+ * behind the tablet's cover glass and ink, which take part of the light, so
+ * this scale reads low until it is calibrated against a lux meter.
+ */
+#define CM36652_GREEN_ULUX_40MS	251680
+
+struct cm36652_data {
+	struct i2c_client *client;
+	/* Serializes the bus accesses and guards reg_conf. */
+	struct mutex lock;
+	u16 reg_conf;	/* CS_CONF1 when running: shutdown bit clear */
+};
+
+#define CM36652_INTENSITY_CHANNEL(_color, _addr) {			\
+	.type = IIO_INTENSITY,						\
+	.modified = 1,							\
+	.channel2 = IIO_MOD_LIGHT_##_color,				\
+	.address = _addr,						\
+	.info_mask_separate = BIT(IIO_CHAN_INFO_RAW),			\
+	.info_mask_shared_by_type = BIT(IIO_CHAN_INFO_INT_TIME),	\
+	.info_mask_shared_by_type_available = BIT(IIO_CHAN_INFO_INT_TIME), \
+}
+
+static const struct iio_chan_spec cm36652_channels[] = {
+	CM36652_INTENSITY_CHANNEL(RED, CM36652_REG_RED),
+	CM36652_INTENSITY_CHANNEL(GREEN, CM36652_REG_GREEN),
+	CM36652_INTENSITY_CHANNEL(BLUE, CM36652_REG_BLUE),
+	CM36652_INTENSITY_CHANNEL(CLEAR, CM36652_REG_WHITE),
+	{
+		.type = IIO_LIGHT,
+		.address = CM36652_REG_GREEN,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_RAW) |
+				      BIT(IIO_CHAN_INFO_SCALE),
+	},
+};
+
+/*
+ * Proximity half off, then the color sensor in its normal configuration.
+ * Called with the chip idle (probe) or with data->lock held (resume).
+ */
+static int cm36652_setup(struct cm36652_data *data)
+{
+	struct i2c_client *client = data->client;
+	int ret;
+
+	ret = i2c_smbus_write_word_data(client, CM36652_REG_PS_CONF1,
+					CM36652_PS_CONF1_OFF);
+	if (ret)
+		return ret;
+
+	ret = i2c_smbus_write_word_data(client, CM36652_REG_PS_CONF3,
+					CM36652_PS_CONF3_OFF);
+	if (ret)
+		return ret;
+
+	return i2c_smbus_write_word_data(client, CM36652_REG_CS_CONF1,
+					 data->reg_conf);
+}
+
+static int cm36652_shutdown(struct cm36652_data *data)
+{
+	return i2c_smbus_write_word_data(data->client, CM36652_REG_CS_CONF1,
+					 data->reg_conf | CM36652_CS_SD);
+}
+
+static void cm36652_disable(void *arg)
+{
+	struct cm36652_data *data = arg;
+	int ret;
+
+	ret = cm36652_shutdown(data);
+	if (ret)
+		dev_err(&data->client->dev, "failed to shut down: %d\n", ret);
+}
+
+static unsigned int cm36652_get_it(struct cm36652_data *data)
+{
+	return FIELD_GET(CM36652_CS_IT_MASK, data->reg_conf);
+}
+
+static int cm36652_read_raw(struct iio_dev *indio_dev,
+			    struct iio_chan_spec const *chan, int *val,
+			    int *val2, long mask)
+{
+	struct cm36652_data *data = iio_priv(indio_dev);
+	unsigned int it;
+	int ret;
+
+	guard(mutex)(&data->lock);
+
+	switch (mask) {
+	case IIO_CHAN_INFO_RAW:
+		ret = i2c_smbus_read_word_data(data->client, chan->address);
+		if (ret < 0)
+			return ret;
+
+		*val = ret;
+		return IIO_VAL_INT;
+	case IIO_CHAN_INFO_INT_TIME:
+		it = cm36652_get_it(data);
+		*val = cm36652_int_time[it][0];
+		*val2 = cm36652_int_time[it][1];
+		return IIO_VAL_INT_PLUS_MICRO;
+	case IIO_CHAN_INFO_SCALE:
+		it = cm36652_get_it(data);
+		*val = 0;
+		*val2 = CM36652_GREEN_ULUX_40MS >> it;
+		return IIO_VAL_INT_PLUS_MICRO;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int cm36652_write_raw(struct iio_dev *indio_dev,
+			     struct iio_chan_spec const *chan, int val,
+			     int val2, long mask)
+{
+	struct cm36652_data *data = iio_priv(indio_dev);
+	unsigned int i;
+	u16 reg_conf;
+	int ret;
+
+	if (mask != IIO_CHAN_INFO_INT_TIME)
+		return -EINVAL;
+
+	for (i = 0; i < ARRAY_SIZE(cm36652_int_time); i++) {
+		if (val == cm36652_int_time[i][0] &&
+		    val2 == cm36652_int_time[i][1])
+			break;
+	}
+	if (i == ARRAY_SIZE(cm36652_int_time))
+		return -EINVAL;
+
+	guard(mutex)(&data->lock);
+
+	reg_conf = data->reg_conf & ~CM36652_CS_IT_MASK;
+	reg_conf |= FIELD_PREP(CM36652_CS_IT_MASK, i);
+
+	ret = i2c_smbus_write_word_data(data->client, CM36652_REG_CS_CONF1,
+					reg_conf);
+	if (ret)
+		return ret;
+
+	data->reg_conf = reg_conf;
+
+	return 0;
+}
+
+static int cm36652_read_avail(struct iio_dev *indio_dev,
+			      struct iio_chan_spec const *chan,
+			      const int **vals, int *type, int *length,
+			      long mask)
+{
+	if (mask != IIO_CHAN_INFO_INT_TIME)
+		return -EINVAL;
+
+	*vals = (const int *)cm36652_int_time;
+	*type = IIO_VAL_INT_PLUS_MICRO;
+	*length = ARRAY_SIZE(cm36652_int_time) * 2;
+
+	return IIO_AVAIL_LIST;
+}
+
+static const struct iio_info cm36652_info = {
+	.read_raw	= cm36652_read_raw,
+	.write_raw	= cm36652_write_raw,
+	.read_avail	= cm36652_read_avail,
+};
+
+static int cm36652_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct cm36652_data *data;
+	struct iio_dev *indio_dev;
+	int ret;
+
+	if (!i2c_check_functionality(client->adapter,
+				     I2C_FUNC_SMBUS_WORD_DATA))
+		return -EOPNOTSUPP;
+
+	indio_dev = devm_iio_device_alloc(dev, sizeof(*data));
+	if (!indio_dev)
+		return -ENOMEM;
+
+	data = iio_priv(indio_dev);
+	i2c_set_clientdata(client, indio_dev);
+	data->client = client;
+	data->reg_conf = CM36652_CS_CONF1_NORMAL;
+
+	mutex_init(&data->lock);
+
+	ret = devm_regulator_get_enable(dev, "vdd");
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable vdd supply\n");
+
+	/* The chip has no ID register: check that it answers a word read. */
+	ret = i2c_smbus_read_word_data(client, CM36652_REG_CS_CONF1);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "no answer at 0x%02x\n",
+				     client->addr);
+
+	dev_dbg(dev, "CS_CONF1 0x%04x at probe\n", ret);
+
+	/*
+	 * Proximity sensor in shutdown first (PS_CONF1 shutdown bit, the IR
+	 * LED stays off), then the color sensor on.
+	 */
+	ret = cm36652_setup(data);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to configure the chip\n");
+
+	ret = devm_add_action_or_reset(dev, cm36652_disable, data);
+	if (ret)
+		return ret;
+
+	indio_dev->name = CM36652_DRV_NAME;
+	indio_dev->info = &cm36652_info;
+	indio_dev->channels = cm36652_channels;
+	indio_dev->num_channels = ARRAY_SIZE(cm36652_channels);
+	indio_dev->modes = INDIO_DIRECT_MODE;
+
+	return devm_iio_device_register(dev, indio_dev);
+}
+
+static int cm36652_suspend(struct device *dev)
+{
+	struct cm36652_data *data = iio_priv(dev_get_drvdata(dev));
+
+	guard(mutex)(&data->lock);
+
+	return cm36652_shutdown(data);
+}
+
+static int cm36652_resume(struct device *dev)
+{
+	struct cm36652_data *data = iio_priv(dev_get_drvdata(dev));
+
+	guard(mutex)(&data->lock);
+
+	/* The proximity half too, in case the chip lost power. */
+	return cm36652_setup(data);
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(cm36652_pm_ops, cm36652_suspend,
+				cm36652_resume);
+
+static const struct i2c_device_id cm36652_id[] = {
+	{ "cm36652" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, cm36652_id);
+
+static const struct of_device_id cm36652_of_match[] = {
+	{ .compatible = "capella,cm36652" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, cm36652_of_match);
+
+static struct i2c_driver cm36652_driver = {
+	.driver = {
+		.name = CM36652_DRV_NAME,
+		.of_match_table = cm36652_of_match,
+		.pm = pm_sleep_ptr(&cm36652_pm_ops),
+	},
+	.probe = cm36652_probe,
+	.id_table = cm36652_id,
+};
+module_i2c_driver(cm36652_driver);
+
+MODULE_DESCRIPTION("Capella CM36652 color light sensor driver");
+MODULE_LICENSE("GPL");
-- 
2.52.0


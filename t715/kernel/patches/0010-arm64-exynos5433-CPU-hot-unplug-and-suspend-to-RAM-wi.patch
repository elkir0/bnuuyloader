From d30e37ad41ab976cf8688d40b7d6d522dca0dc64 Mon Sep 17 00:00:00 2001
From: elkir0 <elkir0@users.noreply.github.com>
Date: Thu, 26 Nov 2026 12:00:00 +0000
Subject: [PATCH] arm64: exynos5433: CPU hot-unplug and suspend to RAM without
 PSCI

Hot-unplug: the 32-bit kernel's exynos5433_cpu_die() from AArch64 EL1:
the HOTPLUG boot flag, the core's local power off in the PMU, then the
monitor's SHUTDOWN call (x1: the core, or the cluster for its last core;
x3 = 0). The monitor compares the id as w0 and takes the same path for
an AArch64 caller; a core it powers back on starts again in AArch32 at
sysram-ns + 0x1c, through the secondaries' stub. cpu_kill polls the PMU
status (arm64's convention: 0 = dead). By hand it stays refused until
/sys/module/smp_exynos5433/parameters/hotplug is 1; a system sleep may.
On the SM-T715: CPU7, the A57 cluster, then all seven secondaries down
to CPU0 alone and back, four rounds, no error.

Suspend to RAM (suspend_exynos5433.c): the 32-bit kernel's PMU and
clock programming unchanged, the monitor's SLEEP call from AArch64
inside cpu_suspend(), and the way back through a second AArch32 stub,
exynos5433_resume_entry, which BL2 jumps to on a wake-up: SMC
0x82000400 to AArch64 EL2, EL2 set up as for a secondary, eret to
cpu_resume at EL1. exynos5433_sleep=on|dryrun and the one-shot arm
switch as on 32 bits. c2test powers one secondary down and back through
the resume stub while the system runs.

On the SM-T715, 2026-11-26: c2test on CPU1 returned 0 (down in 73 us,
back 81 us after power-on); three dry runs; then real sleeps with the
CP and the Wi-Fi/Bluetooth chip down: five of five woke (four on the
PMIC RTC alarm, one on the power key after 165 s on battery, through
the root's t715-sleep), eight cores, Wi-Fi, Bluetooth and the modem
back. A first try with the Wi-Fi chip up never resumed: the board reset
into BOOT.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/Kconfig                      |  15 +
 arch/arm64/kernel/Makefile              |   1 +
 arch/arm64/kernel/smp_exynos5433.c      | 285 +++++++++-
 arch/arm64/kernel/smp_exynos5433_head.S |  98 +++-
 arch/arm64/kernel/suspend_exynos5433.c  | 715 ++++++++++++++++++++++++
 5 files changed, 1078 insertions(+), 36 deletions(-)
 create mode 100644 arch/arm64/kernel/suspend_exynos5433.c

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index e7cb92fa0..daee42eb2 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2447,6 +2447,21 @@ config ARM64_EXYNOS5433_SMP
 	  enable-method = "samsung,exynos5433-el2". With "nosmp", or on a tree
 	  without that property, nothing of it runs.
 
+config ARM64_EXYNOS5433_SUSPEND
+	bool "Exynos 5433: suspend to RAM without PSCI"
+	depends on ARM64_EXYNOS5433_SMP && SUSPEND && HOTPLUG_CPU && CPU_PM
+	default y
+	help
+	  System sleep for a device whose signed bootloader offers no PSCI
+	  (Samsung Galaxy Tab S2 8.0 LTE, SM-T715): the secondary CPUs go
+	  down through the secure monitor's shutdown call, the PMU is set up
+	  as the vendor's 32-bit kernel sets it, and the monitor's sleep call
+	  puts the SoC to sleep. The way back is AArch32: a stub switches
+	  the boot CPU to AArch64 again and enters cpu_resume.
+
+	  Nothing is registered unless the command line has
+	  exynos5433_sleep=on or exynos5433_sleep=dryrun.
+
 config CMDLINE
 	string "Default kernel command string"
 	default ""
diff --git a/arch/arm64/kernel/Makefile b/arch/arm64/kernel/Makefile
index aa7ab0791..624f6c695 100644
--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -58,6 +58,7 @@ obj-$(CONFIG_ACPI)			+= acpi.o
 obj-$(CONFIG_ACPI_NUMA)			+= acpi_numa.o
 obj-$(CONFIG_ARM64_ACPI_PARKING_PROTOCOL)	+= acpi_parking_protocol.o
 obj-$(CONFIG_ARM64_EXYNOS5433_SMP)		+= smp_exynos5433.o smp_exynos5433_head.o
+obj-$(CONFIG_ARM64_EXYNOS5433_SUSPEND)	+= suspend_exynos5433.o
 obj-$(CONFIG_PARAVIRT)			+= paravirt.o
 obj-$(CONFIG_RANDOMIZE_BASE)		+= kaslr.o
 obj-$(CONFIG_HIBERNATION)		+= hibernate.o hibernate-asm.o
diff --git a/arch/arm64/kernel/smp_exynos5433.c b/arch/arm64/kernel/smp_exynos5433.c
index 434f9e9b4..6feee79db 100644
--- a/arch/arm64/kernel/smp_exynos5433.c
+++ b/arch/arm64/kernel/smp_exynos5433.c
@@ -18,12 +18,19 @@
  * No clock, no voltage and no power domain is touched here.
  */
 
+#include <linux/arm-smccc.h>
 #include <linux/delay.h>
 #include <linux/io.h>
+#include <linux/moduleparam.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_address.h>
+#include <linux/cpu.h>
+#include <linux/cpu_pm.h>
+#include <linux/ktime.h>
 #include <linux/smp.h>
+#include <linux/stop_machine.h>
+#include <linux/suspend.h>
 #include <linux/types.h>
 #include <linux/soc/samsung/exynos-regs-pmu.h>
 
@@ -31,6 +38,7 @@
 #include <asm/cacheflush.h>
 #include <asm/cpu_ops.h>
 #include <asm/cputype.h>
+#include <asm/suspend.h>
 
 extern char exynos5433_smp_entry[];		/* AArch32: what the boot register gets */
 extern char exynos5433_smp_entry_el2[];	/* AArch64: what the monitor is given */
@@ -474,17 +482,284 @@ static void exynos5433_cpu_postboot(void)
 	WRITE_ONCE(exynos5433_arrived, true);
 }
 
+#ifdef CONFIG_HOTPLUG_CPU
 /*
- * No cpu_die: without it the kernel refuses to take a CPU offline
- * (op_cpu_disable(), arch/arm64/kernel/smp.c), which is right here.  The
- * monitor's shutdown call the 32-bit kernel makes from AArch32
- * (exynos5433_cpu_die(), platsmp.c:822-875) has not been tried from
- * AArch64.
+ * Hot-unplug: the 32-bit kernel's exynos5433_cpu_die() (platsmp.c:822-875,
+ * stock hotplug.c:99-153): the HOTPLUG boot flag, the core's local power
+ * off in the PMU, then the monitor's shutdown call, which cleans the
+ * caches, takes the core out of coherency and powers it off at its own WFI,
+ * with the cluster when no other core of the cluster is online.  Linux
+ * itself neither cleans nor leaves coherency, as in stock.  A core taken
+ * down this way comes back through exynos5433_cpu_boot(), like at boot.
+ *
+ * Here the call is made from AArch64 at EL1; the monitor takes it the same
+ * way (docs/arm64-monitor-smc.md of the port, §3), and a core it powers
+ * back on starts again in AArch32 at sysram-ns + 0x1c, like at boot.  By
+ * hand it stays refused until asked for at run time
+ * (/sys/module/smp_exynos5433/parameters/hotplug); a system sleep may.
+ */
+
+/* The monitor's ids (arch/arm/mach-exynos/smc.h), negative 32-bit values */
+#define EXYNOS5433_SMC_CMD_SHUTDOWN	(-7)
+#define EXYNOS5433_OP_TYPE_CORE		0
+#define EXYNOS5433_OP_TYPE_CLUSTER	1
+#define EXYNOS5433_SMC_POWERSTATE_IDLE	1
+
+static bool exynos5433_hotplug;
+module_param_named(hotplug, exynos5433_hotplug, bool, 0644);
+MODULE_PARM_DESC(hotplug, "allow secondary CPUs to go offline (the monitor's shutdown call, from AArch64)");
+
+/*
+ * The monitor compares the id as w0 and takes the same path for an AArch64
+ * caller as for an AArch32 one (docs/arm64-monitor-smc.md of the port: §1);
+ * SHUTDOWN reads x1 (0 = this core, else the cluster) and x3 (1 = a
+ * system-level path: always 0 here), not x2; x0-x17 come back clobbered,
+ * which the out-of-line SMCCC call allows for.
+ */
+#define exynos5433_smc_id(id)	((unsigned long)(u32)(id))
+
+/* What a shutdown call that came back left, per PMU core, for cpu_kill */
+static unsigned int exynos5433_die_returns[EXYNOS5433_NR_CORES];
+static unsigned long exynos5433_die_x0[EXYNOS5433_NR_CORES];
+
+static void exynos5433_set_boot_flag(unsigned int idx, u32 flag)
+{
+	void __iomem *word = exynos5433_sysram_ns +
+			     EXYNOS5433_BOOT_FLAG_OFFSET + 4 * idx;
+
+	writel(readl(word) | flag, word);
+}
+
+/* Every core but the boot CPU, once the method is set up */
+static bool exynos5433_cpu_can_disable(unsigned int cpu)
+{
+	return cpu != 0;
+}
+
+static int exynos5433_cpu_disable(unsigned int cpu)
+{
+	/*
+	 * Asked for at run time, or a system sleep taking the secondaries down
+	 * (suspend_exynos5433.c: the boot CPU sleeps alone).
+	 */
+	if (!READ_ONCE(exynos5433_hotplug) &&
+	    pm_suspend_target_state != PM_SUSPEND_MEM)
+		return -EPERM;
+	if (exynos5433_smp_state != EXYNOS5433_SMP_READY)
+		return -ENODEV;
+	return 0;
+}
+
+/*
+ * Runs on the CPU going down, interrupts masked, after it left the online
+ * mask (__cpu_disable()).  It must not return (cpu_die(), smp.c).
+ */
+static void exynos5433_cpu_die(unsigned int cpu)
+{
+	u64 mpidr = cpu_logical_map(cpu);
+	unsigned int idx = exynos5433_pmu_core(mpidr);
+	struct arm_smccc_res res;
+	bool last = true;
+	unsigned int c;
+	u32 val;
+
+	/* another online core in this cluster? (platsmp.c:845-854) */
+	for_each_online_cpu(c)
+		if (MPIDR_AFFINITY_LEVEL(cpu_logical_map(c), 1) ==
+		    MPIDR_AFFINITY_LEVEL(mpidr, 1))
+			last = false;
+
+	for (;;) {
+		exynos5433_set_boot_flag(idx, EXYNOS5433_BOOT_FLAG_HOTPLUG);
+
+		/* stock exynos5433_cpu_down(), pmu-exynos5433.c:130-144 */
+		val = exynos5433_pmu_read(EXYNOS_ARM_CORE_CONFIGURATION(idx));
+		val &= ~EXYNOS5433_CORE_PWR_EN;
+		exynos5433_pmu_write(val, EXYNOS_ARM_CORE_CONFIGURATION(idx));
+
+		dsb(sy);
+		arm_smccc_smc(exynos5433_smc_id(EXYNOS5433_SMC_CMD_SHUTDOWN),
+			      last ? EXYNOS5433_OP_TYPE_CLUSTER :
+				     EXYNOS5433_OP_TYPE_CORE,
+			      EXYNOS5433_SMC_POWERSTATE_IDLE, 0, 0, 0, 0, 0, &res);
+
+		/*
+		 * Back: the core is still powered (stock calls again, until
+		 * its pen opens).  Leave a trace for cpu_kill and wait for an
+		 * event before the next try.
+		 */
+		WRITE_ONCE(exynos5433_die_x0[idx], res.a0);
+		WRITE_ONCE(exynos5433_die_returns[idx],
+			   exynos5433_die_returns[idx] + 1);
+		wfe();
+	}
+}
+
+/*
+ * On another CPU: the PMU status of the core drops once the monitor has
+ * powered it off (platsmp.c:877-900).  arm64's convention, unlike ARM32's:
+ * 0 = dead, an error = maybe not (op_cpu_kill(), smp.c).
+ */
+static int exynos5433_cpu_kill(unsigned int cpu)
+{
+	unsigned int idx = exynos5433_pmu_core(cpu_logical_map(cpu));
+	unsigned int ms;
+
+	for (ms = 0; ms < 100; ms++) {
+		if (!exynos5433_core_powered(idx)) {
+			pr_debug("EXYNOS5433: CPU%u: PMU core %u off after %u ms\n",
+				 cpu, idx, ms);
+			return 0;
+		}
+		mdelay(1);
+	}
+
+	pr_err("EXYNOS5433: CPU%u: PMU core %u still powered 100 ms after its shutdown call (the call came back %u times, x0 0x%lx)\n",
+	       cpu, idx, READ_ONCE(exynos5433_die_returns[idx]),
+	       READ_ONCE(exynos5433_die_x0[idx]));
+	exynos5433_show_core("kill", idx);
+	return -ETIMEDOUT;
+}
+
+#ifdef CONFIG_ARM64_EXYNOS5433_SUSPEND
+/*
+ * A test of the way back from a power-down, on one secondary core while
+ * the rest of the system runs: the core saves its context (cpu_suspend()),
+ * the monitor powers it down (SHUTDOWN), then CPU0 powers it on with the
+ * boot register pointing at exynos5433_resume_entry, the AArch32 stub that a
+ * system sleep's wake-up goes through; the core comes back in cpu_resume
+ * and returns from cpu_suspend().  If any of it fails, that core stays
+ * where it stopped and the others carry on.
+ *
+ *   echo N > /sys/module/smp_exynos5433/parameters/c2test   (N: a CPU, 1-7)
  */
+extern char exynos5433_resume_entry[];
+
+static struct cpu_stop_work exynos5433_c2_stop;
+static int exynos5433_c2_result;
+
+static int exynos5433_c2_finisher(unsigned long idx)
+{
+	struct arm_smccc_res res;
+	u32 val;
+
+	exynos5433_set_boot_flag(idx, EXYNOS5433_BOOT_FLAG_HOTPLUG);
+	val = exynos5433_pmu_read(EXYNOS_ARM_CORE_CONFIGURATION(idx));
+	val &= ~EXYNOS5433_CORE_PWR_EN;
+	exynos5433_pmu_write(val, EXYNOS_ARM_CORE_CONFIGURATION(idx));
+	dsb(sy);
+	arm_smccc_smc(exynos5433_smc_id(EXYNOS5433_SMC_CMD_SHUTDOWN),
+		      EXYNOS5433_OP_TYPE_CORE, EXYNOS5433_SMC_POWERSTATE_IDLE,
+		      0, 0, 0, 0, 0, &res);
+	return 1;			/* came back: the core stayed powered */
+}
+
+static int exynos5433_c2_fn(void *arg)
+{
+	unsigned int idx = exynos5433_pmu_core(read_cpuid_mpidr());
+	int ret;
+
+	local_irq_disable();
+	ret = cpu_pm_enter();
+	if (!ret) {
+		ret = cpu_suspend(idx, exynos5433_c2_finisher);
+		cpu_pm_exit();
+	}
+	local_irq_enable();
+	WRITE_ONCE(exynos5433_c2_result, ret);
+	return 0;
+}
+
+static int exynos5433_c2test_set(const char *val, const struct kernel_param *kp)
+{
+	void __iomem *boot_reg = exynos5433_sysram_ns + EXYNOS5433_BOOT_ADDR_OFFSET;
+	unsigned long resume = __pa_symbol(exynos5433_resume_entry);
+	unsigned long entry = __pa_symbol(exynos5433_smp_entry);
+	unsigned int cpu, idx, us, i;
+	u64 t0, t_off, t_on, t_back;
+	int ret;
+
+	ret = kstrtouint(val, 0, &cpu);
+	if (ret)
+		return ret;
+	if (cpu == 0 || cpu >= nr_cpu_ids || !cpu_online(cpu) ||
+	    exynos5433_smp_state != EXYNOS5433_SMP_READY)
+		return -EINVAL;
+
+	idx = exynos5433_pmu_core(cpu_logical_map(cpu));
+	cpus_read_lock();
+	mutex_lock(&exynos5433_boot_lock);
+
+	WRITE_ONCE(exynos5433_c2_result, -EINPROGRESS);
+	writel(resume, boot_reg);
+	t0 = ktime_get_ns();
+	if (!stop_one_cpu_nowait(cpu, exynos5433_c2_fn, NULL, &exynos5433_c2_stop)) {
+		ret = -EBUSY;
+		goto out;
+	}
+
+	/* down: the PMU status drops (the finisher returns 1 otherwise) */
+	for (us = 0; us < 200000 && exynos5433_core_powered(idx) &&
+	     READ_ONCE(exynos5433_c2_result) == -EINPROGRESS; us += 10)
+		udelay(10);
+	t_off = ktime_get_ns();
+	if (exynos5433_core_powered(idx)) {
+		pr_err("EXYNOS5433: c2test CPU%u: still powered after %u us (result %d)\n",
+		       cpu, us, READ_ONCE(exynos5433_c2_result));
+		ret = -ETIMEDOUT;
+		goto wait;
+	}
+
+	udelay(1000);
+	exynos5433_core_power_up(idx);
+	t_on = ktime_get_ns();
+	for (i = 0; i < EXYNOS5433_RELEASE_TRIES &&
+	     READ_ONCE(exynos5433_c2_result) == -EINPROGRESS; i++) {
+		writel(resume, boot_reg);
+		dsb(sy);
+		sev();
+		udelay(10);
+	}
+	t_back = ktime_get_ns();
+wait:
+	ret = READ_ONCE(exynos5433_c2_result);
+	pr_info("EXYNOS5433: c2test CPU%u (PMU core %u): cpu_suspend() returned %d; down in %llu us, back %llu us after power-on (%u tries)\n",
+		cpu, idx, ret, (t_off - t0) / 1000,
+		ret == -EINPROGRESS ? 0 : (t_back - t_on) / 1000, i);
+	if (ret == -EINPROGRESS) {
+		pr_err("EXYNOS5433: c2test CPU%u: did not come back; that core is lost until reboot\n",
+		       cpu);
+		exynos5433_show_core("c2test", idx);
+		exynos5433_smp_state = EXYNOS5433_SMP_FAILED;
+		ret = -EIO;
+	} else if (ret) {
+		ret = -EIO;
+	}
+out:
+	writel(entry, boot_reg);
+	exynos5433_clear_boot_flag(idx, EXYNOS5433_BOOT_FLAG_HOTPLUG);
+	mutex_unlock(&exynos5433_boot_lock);
+	cpus_read_unlock();
+	return ret;
+}
+
+static const struct kernel_param_ops exynos5433_c2test_ops = {
+	.set	= exynos5433_c2test_set,
+};
+module_param_cb(c2test, &exynos5433_c2test_ops, NULL, 0200);
+#endif /* CONFIG_ARM64_EXYNOS5433_SUSPEND */
+#endif /* CONFIG_HOTPLUG_CPU */
+
 const struct cpu_operations exynos5433_smp_ops = {
 	.name		= "samsung,exynos5433-el2",
 	.cpu_init	= exynos5433_cpu_init,
 	.cpu_prepare	= exynos5433_cpu_prepare,
 	.cpu_boot	= exynos5433_cpu_boot,
 	.cpu_postboot	= exynos5433_cpu_postboot,
+#ifdef CONFIG_HOTPLUG_CPU
+	.cpu_can_disable = exynos5433_cpu_can_disable,
+	.cpu_disable	= exynos5433_cpu_disable,
+	.cpu_die	= exynos5433_cpu_die,
+	.cpu_kill	= exynos5433_cpu_kill,
+#endif
 };
diff --git a/arch/arm64/kernel/smp_exynos5433_head.S b/arch/arm64/kernel/smp_exynos5433_head.S
index b87f6b49a..4c63daa24 100644
--- a/arch/arm64/kernel/smp_exynos5433_head.S
+++ b/arch/arm64/kernel/smp_exynos5433_head.S
@@ -37,6 +37,53 @@
 #include <asm/ptrace.h>
 #include <asm/sysreg.h>
 
+/*
+ * The twelve AArch32 words of an entry the monitor (or BL2, on a wake-up)
+ * jumps to, in AArch32 SVC with the MMU off: SMC 0x82000400 to the AArch64
+ * code exactly 2048 bytes after the first word.  The source is in the
+ * comment of exynos5433_smp_entry.
+ */
+	.macro	exynos5433_ex32_words
+	.word	0xf10c01c0		// cpsid	aif
+	.word	0xe59f1020		// ldr	r1, 3f
+	.word	0xe081100f		// add	r1, r1, pc
+	.word	0xe3000400		// movw	r0, #0x400
+	.word	0xe3480200		// movt	r0, #0x8200
+	.word	0xe3a02b02		// mov	r2, #0x800
+	.word	0xe3a03001		// mov	r3, #1
+	.word	0xf57ff04f		// dsb	sy
+	.word	0xe1600070		// smc	#0
+	.word	0xe320f002		// wfe
+	.word	0xeafffffd		// b	1b
+	.word	0x000007f0		// 2048 - 16
+	.endm
+
+/*
+ * EL2 as the loader leaves it for the boot CPU, then eret to EL1 at \target,
+ * MMU off, every exception masked (see exynos5433_smp_entry_el2).
+ */
+	.macro	exynos5433_el2_to_el1, target
+	msr	daifset, #0xf
+	mov_q	x0, HCR_RW
+	msr	hcr_el2, x0
+	mrs	x0, cnthctl_el2
+	orr	x0, x0, #3
+	msr	cnthctl_el2, x0
+	msr	cntvoff_el2, xzr
+	msr	cptr_el2, xzr
+	msr	mdcr_el2, xzr
+	mov_q	x0, INIT_SCTLR_EL1_MMU_OFF
+	msr	sctlr_el1, x0
+	ic	iallu
+	dsb	sy
+	isb
+	adr_l	x0, \target		// a physical address: the MMU is off
+	msr	elr_el2, x0
+	mov_q	x0, INIT_PSTATE_EL1	// EL1h, every exception masked
+	msr	spsr_el2, x0
+	eret
+	.endm
+
 /*
  * The monitor takes a 32-bit entry address, so both entries must be below
  * 4 GiB: smp_exynos5433.c refuses to start a core otherwise.  The AArch64
@@ -70,18 +117,7 @@ SYM_START(exynos5433_smp_entry, SYM_L_GLOBAL, SYM_A_NONE)
 	 *3:	.word	exynos5433_smp_entry_el2 - exynos5433_smp_entry - 16
 	 */
 .Lex32_words:
-	.word	0xf10c01c0		// cpsid	aif
-	.word	0xe59f1020		// ldr	r1, 3f
-	.word	0xe081100f		// add	r1, r1, pc
-	.word	0xe3000400		// movw	r0, #0x400
-	.word	0xe3480200		// movt	r0, #0x8200
-	.word	0xe3a02b02		// mov	r2, #0x800
-	.word	0xe3a03001		// mov	r3, #1
-	.word	0xf57ff04f		// dsb	sy
-	.word	0xe1600070		// smc	#0
-	.word	0xe320f002		// wfe
-	.word	0xeafffffd		// b	1b
-	.word	0x000007f0		// 2048 - 16
+	exynos5433_ex32_words
 .Lex32_words_end:
 SYM_FUNC_END(exynos5433_smp_entry)
 
@@ -107,25 +143,7 @@ SYM_FUNC_END(exynos5433_smp_entry)
  * boot CPU of this kernel has exactly this EL2, and the cores must agree.
  */
 SYM_START(exynos5433_smp_entry_el2, SYM_L_GLOBAL, SYM_A_NONE)
-	msr	daifset, #0xf
-	mov_q	x0, HCR_RW
-	msr	hcr_el2, x0
-	mrs	x0, cnthctl_el2
-	orr	x0, x0, #3

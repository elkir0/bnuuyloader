index 000000000..0340b8f8c
--- /dev/null
+++ b/arch/arm64/kernel/suspend_exynos5433.c
@@ -0,0 +1,715 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Exynos 5433: system sleep (suspend to RAM) of a 64-bit kernel, without PSCI.
+ *
+ * The 32-bit kernel of this board sleeps through Samsung's secure monitor
+ * the way the vendor kernel does (arch/arm/mach-exynos/suspend.c of the
+ * release tree, "the 32-bit kernel" below): every secondary core taken down,
+ * the PMU programmed for the central sequencer, the resume address and the
+ * 0xbad flag left in sysram-ns, then the monitor's SLEEP call inside
+ * cpu_suspend().  This file is that code: the PMU and clock part is the
+ * 32-bit kernel's, unchanged; what was ARM32 is replaced:
+ *
+ *  - the monitor call is made from AArch64 at EL1.  The monitor compares the
+ *    id as w0 and runs the same SLEEP handler for an AArch64 caller; that
+ *    handler cleans every cache level by set/way, leaves coherency and waits
+ *    for the sequencer, so Linux cleans nothing (docs/arm64-monitor-smc.md of
+ *    the port, §1-2);
+ *  - the way back is AArch32, whatever the caller was: on wake-up the monitor
+ *    reruns its cold init, BL2 finds 0xbad and jumps to the resume address in
+ *    AArch32 SVC with the MMU off.  So that address is a twelve-word AArch32
+ *    stub (smp_exynos5433_head.S) which makes the call a loader makes for the
+ *    boot CPU, SMC 0x82000400, lands in AArch64 at EL2, sets EL2 up as for a
+ *    secondary core and enters cpu_resume at EL1;
+ *  - the secondary cores go down and come back through the hot-unplug of
+ *    smp_exynos5433.c.
+ *
+ * Off unless the command line has exynos5433_sleep=on or =dryrun, as in the
+ * 32-bit kernel.
+ */
+
+#include <linux/arm-smccc.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/moduleparam.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/printk.h>
+#include <linux/sizes.h>
+#include <linux/soc/samsung/exynos-regs-pmu.h>
+#include <linux/suspend.h>
+#include <linux/syscore_ops.h>
+
+#include <asm/cputype.h>
+#include <asm/suspend.h>
+
+static void __iomem *exynos5433_pmu_base __ro_after_init;
+static void __iomem *exynos5433_sysram_ns_base __ro_after_init;
+
+static inline void pmu_raw_writel(u32 val, u32 offset)
+{
+	writel_relaxed(val, exynos5433_pmu_base + offset);
+}
+
+static inline u32 pmu_raw_readl(u32 offset)
+{
+	return readl_relaxed(exynos5433_pmu_base + offset);
+}
+
+/*
+ * The 32-bit kernel's exynos_irqwake_intmask: the PMU irqchip that would
+ * change it is not used on this SoC (its PMU node is no interrupt
+ * controller), so it keeps its initial value.
+ */
+#define exynos_irqwake_intmask		0xffffffffU
+
+static int exynos5433_firmware_suspend(void);
+
+enum exynos5433_sleep_mode {
+	EXYNOS5433_SLEEP_OFF,
+	EXYNOS5433_SLEEP_ON,
+	EXYNOS5433_SLEEP_DRYRUN,
+};
+
+static enum exynos5433_sleep_mode exynos5433_sleep __ro_after_init;
+
+static int __init exynos5433_sleep_setup(char *str)
+{
+	if (!str)
+		return -EINVAL;
+
+	if (!strcmp(str, "on") || !strcmp(str, "1"))
+		exynos5433_sleep = EXYNOS5433_SLEEP_ON;
+	else if (!strcmp(str, "dryrun"))
+		exynos5433_sleep = EXYNOS5433_SLEEP_DRYRUN;
+	else
+		exynos5433_sleep = EXYNOS5433_SLEEP_OFF;
+
+	return 0;
+}
+early_param("exynos5433_sleep", exynos5433_sleep_setup);
+
+/*
+ * A kernel booted with exynos5433_sleep=dryrun sleeps for real only when
+ * armed, one sleep at a time:
+ *
+ *   echo 1 > /sys/module/exynos5433_sleep/parameters/arm
+ *
+ * The next .enter issues SMC_CMD_SLEEP and disarms, so the parameter reads
+ * N again after that attempt, whatever its outcome.  The daily kernel boots
+ * so, and the root's sleep hook arms each sleep once the CP and the
+ * Wi-Fi/Bluetooth chip are powered down: a suspend that nothing prepared
+ * stays a dry run.  Test kernels use the switch the same way, so that their
+ * dry runs and real sleeps need no second image.  A kernel booted with
+ * exynos5433_sleep=on always sleeps, and one booted without the switch
+ * registers no system sleep at all, armed or not.
+ */
+static bool exynos5433_sleep_armed;
+#undef MODULE_PARAM_PREFIX
+#define MODULE_PARAM_PREFIX "exynos5433_sleep."
+module_param_named(arm, exynos5433_sleep_armed, bool, 0600);
+

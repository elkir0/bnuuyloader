# The lines added on 2026-11-24, on top of config-arm64.changes:
# the eight-core start method of linux-smp (patches 0001-0005 of smp/, cherry-picked on t715-arm64),
# and the initramfs of the root image work stream built into the Image (the loader passes no initrd).
CONFIG_ARM64_EXYNOS5433_SMP=y
CONFIG_INITRAMFS_SOURCE="/work/initramfs-root /work/initramfs-extra.list"
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
# 2.1.0 (2026-11-26): suspend to RAM without PSCI (patch 0010).
CONFIG_ARM64_EXYNOS5433_SUSPEND=y
# 2.1.0: 32-bit user space (AArch32 EL0), for Waydroid's arm64 image, which runs 32-bit services (boringssl_self_test32, zygote64_32) and 32-bit apps.
CONFIG_COMPAT=y
# 2026-11-27: cpuidle without PSCI, C2 per core through the monitor (patch 0011,
# drivers/cpuidle/cpuidle-exynos5433.c), registered at boot with cpuidle_exynos5433.enable=1.
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_ARM64_EXYNOS5433_CPUIDLE=y
# 2026-11-27: the energy model, for energy-aware scheduling (patch 0012: each CPU node's
# dynamic-power-coefficient, measured on the tablet; cpufreq-dt registers one perf domain per cluster).
CONFIG_ENERGY_MODEL=y
# 2026-11-28: USB host through an OTG adapter.  dwc3 in dual role (its role from the SM5703 MUIC's
# extcon, the board's exynos5433-gts28ltexx-otg.dtsi), xHCI, and the class drivers a tablet used as
# a small computer needs: keys and disks, keyboards and mice, Ethernet adapters and phone tethering,
# sound cards, serial adapters, webcams.
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_GADGET=n
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_NTFS3_FS=m
CONFIG_HID_MULTITOUCH=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m
CONFIG_HID_APPLE=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_RTL8152=m
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_ACM=m
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=m
# 2026-11-28: the MFC v8 video codec (s5p-mfc, a module; the board's exynos5433-gts28ltexx-mfc.dtsi
# feeds it ACLK_MFC_400): H.264, VP8, MPEG and VC-1 decoding for mpv and GStreamer.
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEO_SAMSUNG_S5P_MFC=m
# 2026-11-28: security.* extended attributes on ext4, so the root keeps file capabilities (the
# 32-bit release builds without them; t715-golden-caps.service worked around it).
CONFIG_EXT4_FS_SECURITY=y
# 2026-11-28: the Capella CM36652 ambient light sensor (the board's exynos5433-gts28ltexx-als.dtsi),
# for automatic brightness; its proximity half stays in shutdown.
CONFIG_CM36652=m
